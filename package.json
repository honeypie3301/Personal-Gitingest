{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "build:static": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/server.mjs",
    "start": "npm run build && (node --expose-gc --max-old-space-size=512 dist-server/server.mjs || node server.ts)",
    "restart": "restart.bat",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist-server",
    "lint": "tsc --noEmit",
    "worker": "tsx worker/server.ts",
    "test:ingest": "tsx --test tests/performance/*.test.ts",
    "benchmark:ingest": "tsx tests/performance/benchmark.ts",
    "benchmark:decompiler": "tsx tests/performance/decompilerBenchmark.ts",
    "setup:autostart": "node scripts/setup-autostart.js",
    "stop:background": "node scripts/stop-background.js",
    "auto": "node scripts/setup-autostart.js",
    "stop": "node scripts/stop-background.js",
    "stats": "stats.bat"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/lib-storage": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
